# Copy to .env:  cp .env.example .env
# Never commit the real .env — it's git-ignored. See docs/security/06-secrets-management.md

# --- App ---
APP_NAME=dataforge
APP_ENV=local
APP_DEBUG=true
APP_PORT=8000
APP_URL=http://localhost:${APP_PORT}

# --- Frontend ---
FRONTEND_PORT=5173

# --- Database (shared by Laravel + Python) ---
# Host is the compose service name "db", not localhost, when running in Docker.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dataforge
DB_USERNAME=app
DB_PASSWORD=secret

# --- Python importer ---
# How often the worker checks for new pending imports (seconds).
IMPORT_POLL_SECONDS=3
# Where uploaded files are mounted inside the importer container.
IMPORT_DIR=/data/imports

# --- RAG (customers /ask) ---
# console.groq.com/keys -- used by python-service only, never sent to the browser.
GROQ_API_KEY=

# --- Auth / Sanctum ---
# Domains that Sanctum treats as first-party (session auth, not tokens).
SANCTUM_STATEFUL_DOMAINS=localhost:${FRONTEND_PORT},localhost:${APP_PORT},127.0.0.1:${FRONTEND_PORT},127.0.0.1:${APP_PORT}
# Cookie domain shared across frontend + backend ports.
SESSION_DOMAIN=localhost
# Frontend origin for CORS.
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# --- Vue SPA ---
# Base URL the Vue SPA uses to reach the API.
VITE_API_URL=http://localhost:${APP_PORT}
